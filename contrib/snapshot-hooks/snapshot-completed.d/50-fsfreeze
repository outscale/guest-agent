#!/usr/bin/env bash
# FITHAW (fsfreeze --unfreeze) on the filesystem mounted from MOUNT_POINT
# (block device). Runs before 90-pod-exec so the workload resumes on a thawed fs.
set -euo pipefail
HOOK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib.sh
source "$HOOK_ROOT/lib.sh"

PHASE=completed
resolve_mount_and_pod
fs_unfreeze
