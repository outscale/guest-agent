#!/usr/bin/env bash
# Run pod completed-command annotation after the filesystem is thawed
# (sorted after 50-fsfreeze, so the workload never resumes on a frozen fs).
# Annotation (on Pod): snapshot.bsu.csi.outscale.com/completed-command = JSON argv array
# Optional: snapshot.bsu.csi.outscale.com/container = container name
set -euo pipefail
HOOK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib.sh
source "$HOOK_ROOT/lib.sh"

PHASE=completed
resolve_mount_and_pod
pod_exec_annotation "$ANN_COMPLETED"
