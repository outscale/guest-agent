#!/usr/bin/env bash
# Run pod commit-command annotation.
# The volume must stay quiet until the completed phase: do not resume writes
# from this hook, do it from snapshot-completed.d instead.
# Annotation (on Pod): snapshot.bsu.csi.outscale.com/commit-command = JSON argv array
# Optional: snapshot.bsu.csi.outscale.com/container = container name
set -euo pipefail
HOOK_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib.sh
source "$HOOK_ROOT/lib.sh"

PHASE=commit
resolve_mount_and_pod
pod_exec_annotation "$ANN_COMMIT"
